{
  "nodeModulesDir": "auto",
  "tasks": {
    "trader:dry-run": "deno test --allow-all --no-check --env-file ./trader/dry_run/index.ts",
    "trader:live": "deno run --allow-all --no-check --env-file ./trader/src/master.ts"
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "dom"
    ]
  },
  "imports": {
    "@/shared/": "./shared/",
    "@/watcher/": "./watcher/src/",
    "@/trader/": "./trader/src/",
    "@/scripts/": "./scripts/",
    "@/": "./",
    "@deno-library/logger": "jsr:@deno-library/logger@^1.1.7",
    "@logger": "jsr:@deno-library/logger@^1.1.7",
    "@influxdata/influxdb-client": "npm:@influxdata/influxdb-client@^1.35.0",
    "@influxdata/influxdb-client-apis": "npm:@influxdata/influxdb-client-apis@^1.35.0",
    "@solana/spl-token": "npm:@solana/spl-token@^0.4.9",
    "@solana/web3.js": "npm:@solana/web3.js@^1.98.0",
    "@std/assert": "jsr:@std/assert@1",
    "@std/testing": "jsr:@std/testing@^1.0.8",
    "axios": "npm:axios@^1.7.9",
    "bs58": "npm:bs58@^6.0.0",
    "dotenv": "npm:dotenv@^16.4.7"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ], 
      "exclude": [
        "no-unused-vars",
        "require-await"
      ]
    }
  },
  "fmt": {
    "options": {
      "useTabs": false,
      "lineWidth": 120,
      "indentWidth": 2,
      "singleQuote": true,
      "semiColons": false
    }
  }
}